{
  "name": "university-basketball",
  "productName": "University Basketball",
  "version": "1.0.0",
  "description": "A college basketball career simulation game.",
  "author": "Dashaun Barnes",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:all": "electron-builder --mac --win"
  },
  "build": {
    "appId": "com.universitybasketball.game",
    "productName": "University Basketball",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "gameplay.js",
      "teams.js",
      "soundtrack.mp3",
      "electron-main.cjs",
      "package.json",
      "!customrosters/**",
      "!custom-rosters*.json",
      "!custom-team-names.example.json",
      "!name_lists.py",
      "!server.mjs",
      "!progress.md"
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1"
  }
}
